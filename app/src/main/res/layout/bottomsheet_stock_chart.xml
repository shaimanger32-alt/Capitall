<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_base"
    android:paddingBottom="16dp">

    <View
        android:id="@+id/dragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bottomsheet_drag_handle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:textColor="@color/accent_blue"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/dragHandle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvCompanyName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/on_surface_muted"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvSymbol"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:textColor="@color/on_surface"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvCompanyName"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvChange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvPrice"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSelectedPoint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/accent_blue"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvChange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.shai.capitall.ui.common.ComparisonLineChart
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSelectedPoint" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/lineChart"
        app:layout_constraintBottom_toBottomOf="@id/lineChart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvChartError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stock_chart_error_load_failed"
        android:textColor="@color/on_surface_muted"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/lineChart"
        app:layout_constraintBottom_toBottomOf="@id/lineChart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/rangeSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@id/lineChart">

        <TextView
            android:id="@+id/btnRange1D"
            style="@style/StockChartRangeButton"
            android:text="@string/stock_chart_range_1d" />

        <TextView
            android:id="@+id/btnRange1W"
            style="@style/StockChartRangeButton"
            android:text="@string/stock_chart_range_1w" />

        <TextView
            android:id="@+id/btnRange1M"
            style="@style/StockChartRangeButton"
            android:text="@string/stock_chart_range_1m" />

        <TextView
            android:id="@+id/btnRange6M"
            style="@style/StockChartRangeButton"
            android:text="@string/stock_chart_range_6m" />

        <TextView
            android:id="@+id/btnRange1Y"
            style="@style/StockChartRangeButton"
            android:text="@string/stock_chart_range_1y" />

        <TextView
            android:id="@+id/btnRange5Y"
            style="@style/StockChartRangeButton"
            android:text="@string/stock_chart_range_5y" />

        <TextView
            android:id="@+id/btnRangeMax"
            style="@style/StockChartRangeButton"
            android:text="@string/stock_chart_range_max" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
