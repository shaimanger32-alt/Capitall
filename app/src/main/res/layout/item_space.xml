<?xml version="1.0" encoding="utf-8"?>
<!-- שורת תיק משותף: שם, מספר חברים, וקוד ההצטרפות -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/hairline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_category_icon">

            <TextView
                android:id="@+id/tvSpaceInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/accent_blue"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="ד" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSpaceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="דירה ברוטשילד" />

            <TextView
                android:id="@+id/tvSpaceMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_surface_muted"
                android:textSize="12.5sp"
                tools:text="שי · דנה · יואב" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSpaceCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/badge_background"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="K7QM24" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
