<?xml version="1.0" encoding="utf-8"?>
<!-- שורת skeleton בודדת: ריבוע אייקון + שני פסי טקסט + פס ערך -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_md">

    <View
        android:layout_width="@dimen/icon_container"
        android:layout_height="@dimen/icon_container"
        android:background="@drawable/bg_category_icon"
        android:backgroundTint="@color/surface_elevated" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="140dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_skeleton_line" />

        <View
            android:layout_width="84dp"
            android:layout_height="10dp"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_line" />
    </LinearLayout>

    <View
        android:layout_width="64dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_skeleton_line" />

</LinearLayout>
