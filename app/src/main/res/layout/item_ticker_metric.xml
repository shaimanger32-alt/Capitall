<?xml version="1.0" encoding="utf-8"?>
<!-- כרטיסון מדד בטיקר האופקי: תווית זעירה מעל ערך + מחוון מגמה -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_sm"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/radius_sm"
    app:cardElevation="@dimen/elevation_flat"
    app:strokeColor="@color/hairline"
    app:strokeWidth="@dimen/hairline">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm">

        <TextView
            android:id="@+id/tvTickerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/on_surface_muted"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTickerIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTickerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
