<?xml version="1.0" encoding="utf-8"?>
<!-- שורת תת-קטגוריה (leaf) — נפתחת מתחת לקבוצת-העל -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/leafRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginHorizontal="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_category_leaf"
    android:paddingHorizontal="14dp"
    android:paddingVertical="14dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_category_icon"
        android:backgroundTint="#1A000000">

        <ImageView
            android:id="@+id/ivLeafIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvLeafName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:textColor="@color/picker_text_primary"
        android:textSize="17sp" />

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_chevron_end"
        android:alpha="0.35"
        android:importantForAccessibility="no" />

</LinearLayout>
