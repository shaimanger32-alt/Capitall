<?xml version="1.0" encoding="utf-8"?>
<!-- שורת כותרת קבוצת-על (accordion header) — הרקע והצבעים נצבעים דינמית לפי הקבוצה -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/groupRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_category_group"
    android:paddingHorizontal="14dp"
    android:paddingVertical="14dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_category_icon"
        android:backgroundTint="#22000000">

        <ImageView
            android:id="@+id/ivGroupIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvGroupName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_end"
        android:rotation="90"
        android:importantForAccessibility="no" />

</LinearLayout>
