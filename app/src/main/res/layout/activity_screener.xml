<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/surface_base">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/surface_card"
                android:elevation="4dp"
                android:title="@string/screener_title"
                android:titleTextColor="@color/on_surface"
                app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                app:navigationIconTint="@color/on_surface" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Area 1: Filter Card -->
                    <androidx.cardview.widget.CardView
                        style="@style/Widget.Capitall.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipDateRange"
                                        style="@style/Widget.Capitall.Chip"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:text="@string/screener_filter_date_all" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipCategories"
                                        style="@style/Widget.Capitall.Chip"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:text="@string/screener_filter_categories" />

                                </LinearLayout>
                            </HorizontalScrollView>

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/toggleType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:background="@drawable/bg_segmented_track"
                                android:padding="3dp"
                                app:singleSelection="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnTypeAll"
                                    style="@style/Widget.Capitall.SegmentedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/screener_type_all"
                                    android:checked="true" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnTypeExpenses"
                                    style="@style/Widget.Capitall.SegmentedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/screener_type_expenses" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnTypeIncome"
                                    style="@style/Widget.Capitall.SegmentedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/screener_type_income" />

                            </com.google.android.material.button.MaterialButtonToggleGroup>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/screener_min_amount"
                                    app:boxStrokeColor="@color/accent_blue"
                                    app:hintTextColor="@color/on_surface_muted">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etMinAmount"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="numberDecimal"
                                        android:textColor="@color/on_surface" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:hint="@string/screener_max_amount"
                                    app:boxStrokeColor="@color/accent_blue"
                                    app:hintTextColor="@color/on_surface_muted">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etMaxAmount"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="numberDecimal"
                                        android:textColor="@color/on_surface" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvClearAll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:layout_marginTop="10dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:padding="6dp"
                                android:text="@string/screener_clear_all"
                                android:textColor="@color/accent_blue"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Area 2: Stats Strip -->
                    <androidx.cardview.widget.CardView
                        style="@style/Widget.Capitall.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:cardBackgroundColor="@color/surface_elevated">

                        <TextView
                            android:id="@+id/tvStatsStrip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="12sp" />

                    </androidx.cardview.widget.CardView>

                    <!-- Area 3: Table Card -->
                    <androidx.cardview.widget.CardView
                        style="@style/Widget.Capitall.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="6dp">

                                <TextView
                                    android:id="@+id/headerDate"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:text="@string/screener_col_date"
                                    android:textColor="@color/on_surface_muted"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.03" />

                                <TextView
                                    android:id="@+id/headerMerchant"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2.3"
                                    android:text="@string/screener_col_merchant"
                                    android:textColor="@color/on_surface_muted"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.03" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.6"
                                    android:text=""
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/headerAmount"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:gravity="end"
                                    android:text="@string/screener_col_amount"
                                    android:textColor="@color/on_surface_muted"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.03" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="4dp"
                                android:background="@color/hairline" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerViewTable"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </FrameLayout>

    <!-- Side Drawer - Transaction Detail -->
    <androidx.cardview.widget.CardView
        android:layout_width="308dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="0dp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvDetailMerchant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/hairline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/screener_detail_category"
                    android:textAppearance="@style/TextAppearance.Capitall.MetricLabel" />

                <Spinner
                    android:id="@+id/spinnerDetailCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/screener_detail_notes"
                    android:textAppearance="@style/TextAppearance.Capitall.MetricLabel" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDetailNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/badge_background"
                    android:gravity="top"
                    android:minLines="3"
                    android:padding="12dp"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/screener_detail_recurring"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switchRecurring"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnSaveDetail"
                    style="@style/Widget.Capitall.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/add_entry_save" />

                <Button
                    android:id="@+id/btnDeleteDetail"
                    style="@style/Widget.Capitall.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/screener_detail_delete" />

                <Button
                    android:id="@+id/btnCloseDetail"
                    style="@style/Widget.Capitall.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/screener_detail_close" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.cardview.widget.CardView>

</androidx.drawerlayout.widget.DrawerLayout>
