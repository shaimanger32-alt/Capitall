<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      ראש המסך כולו יושב על גרדיאנט כחול רציף (סרגל + חיפוש + טיקר + השווי הנקי),
      והתוכן הלבן מתעגל מעליו. כך הכחול הוא חלק מהדף ולא "קופסה" נפרדת.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dashboard_header"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:title="@string/dashboard_toolbar_title"
            android:titleTextColor="#FFFFFF"
            app:navigationIconTint="#FFFFFF"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

        <!-- שורת חיפוש גלובלית — גלולה שקופה-לבנה על הכחול -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_search_on_blue">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:drawableTint="#CFE0FF"
                android:hint="@string/dashboard_search_hint"
                android:inputType="text"
                android:minHeight="48dp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#CFE0FF"
                android:textSize="14sp" />

        </FrameLayout>

        <!-- טיקר פיננסי אופקי -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp" />

        <!--
          עוטף את אזור הגלילה כדי שכפתור ההוספה ירחף מעליו במקום להיגלל איתו.
          ה-FAB מוצהר אחרי הגלילה ולכן מרונדר מעליה.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipToPadding="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="96dp">

                <!-- ===== בלוק השווי הנקי — יושב ישירות על הכחול של ראש המסך ===== -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardHero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="26dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- eyebrow: נקודה בהירה + תווית -->
                    <View
                        android:id="@+id/heroEyebrowDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_hero_pill"
                        app:layout_constraintTop_toTopOf="@id/tvNetWorthLabel"
                        app:layout_constraintBottom_toBottomOf="@id/tvNetWorthLabel"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvNetWorthLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/dashboard_net_worth_label"
                        android:textAppearance="@style/TextAppearance.Capitall.HeroLabel"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/heroEyebrowDot" />

                    <!-- הסתרת השווי הנקי — נשמר בין הפעלות -->
                    <ImageButton
                        android:id="@+id/btnToggleBalance"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/dashboard_toggle_balance_desc"
                        android:padding="6dp"
                        android:src="@drawable/ic_eye"
                        app:tint="#CFE0FF"
                        app:layout_constraintTop_toTopOf="@id/tvNetWorthLabel"
                        app:layout_constraintBottom_toBottomOf="@id/tvNetWorthLabel"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvNetWorthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        android:text="₪0"
                        android:textAppearance="@style/TextAppearance.Capitall.HeroValue"
                        app:layout_constraintTop_toBottomOf="@id/tvNetWorthLabel"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!--
                  היריעה הלבנה: מתעגלת מעל הכחול ונמשכת עד תחתית התוכן.
                  מרווחים שליליים מבטלים את ריפוד הצדדים של ההורה כדי שתהיה רוחב-מלא (ללא "קופסה").
                -->
                <View
                    android:id="@+id/contentSheet"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="-16dp"
                    android:layout_marginEnd="-16dp"
                    android:background="@drawable/bg_content_sheet"
                    app:layout_constraintTop_toBottomOf="@id/cardHero"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipChartView"
                    style="@style/Widget.Capitall.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    app:layout_constraintTop_toBottomOf="@id/cardHero"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTimeRange"
                    style="@style/Widget.Capitall.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintTop_toBottomOf="@id/cardHero"
                    app:layout_constraintStart_toEndOf="@id/chipChartView" />

                    <com.shai.capitall.ui.common.ComparisonLineChart
                        android:id="@+id/netWorthChart"
                        android:layout_width="0dp"
                        android:layout_height="230dp"
                        android:layout_marginTop="14dp"
                        android:contentDescription="@string/dashboard_networth_chart_desc"
                        app:layout_constraintTop_toBottomOf="@id/chipChartView"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/heroDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/hairline"
                        app:layout_constraintTop_toBottomOf="@id/netWorthChart"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- פירוט נכסים -->
                    <LinearLayout
                        android:id="@+id/blockAssets"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@id/heroDivider"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/heroVerticalDivider">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="7dp"
                                android:background="@drawable/dot_asset" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_assets_label"
                                android:textAppearance="@style/TextAppearance.Capitall.MetricLabel" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTotalAssets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="₪0"
                            android:textColor="@color/green_positive"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:id="@+id/heroVerticalDivider"
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:background="@color/hairline"
                        app:layout_constraintTop_toTopOf="@id/blockAssets"
                        app:layout_constraintBottom_toBottomOf="@id/blockAssets"
                        app:layout_constraintStart_toEndOf="@id/blockAssets"
                        app:layout_constraintEnd_toStartOf="@id/blockLiabilities" />

                    <!-- פירוט התחייבויות -->
                    <LinearLayout
                        android:id="@+id/blockLiabilities"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        app:layout_constraintTop_toTopOf="@id/blockAssets"
                        app:layout_constraintStart_toEndOf="@id/heroVerticalDivider"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="7dp"
                                android:background="@drawable/dot_liability" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_liabilities_label"
                                android:textAppearance="@style/TextAppearance.Capitall.MetricLabel" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTotalLiabilities"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="₪0"
                            android:textColor="@color/red_negative"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                <!-- תחתית אזור הסיכום (נכסים/התחייבויות) — עוגן לסעיפים שאחריו -->
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/heroBottomBarrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="blockAssets,blockLiabilities" />

                <!-- ===== Section 1: Overview / KPIs ===== -->
                <View
                    android:id="@+id/accentOverview"
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_section_accent"
                    app:layout_constraintTop_toBottomOf="@id/heroBottomBarrier"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvKpiSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/dashboard_overview_title"
                    android:textAppearance="@style/TextAppearance.Capitall.SectionTitle"
                    app:layout_constraintTop_toTopOf="@id/accentOverview"
                    app:layout_constraintBottom_toBottomOf="@id/accentOverview"
                    app:layout_constraintStart_toEndOf="@id/accentOverview" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewKpi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/accentOverview"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- ===== Section 2: Cash Flow ===== -->
                <View
                    android:id="@+id/accentCashFlow"
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_section_accent"
                    app:layout_constraintTop_toBottomOf="@id/recyclerViewKpi"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvCashFlowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/dashboard_cashflow_title"
                    android:textAppearance="@style/TextAppearance.Capitall.SectionTitle"
                    app:layout_constraintTop_toTopOf="@id/accentCashFlow"
                    app:layout_constraintBottom_toBottomOf="@id/accentCashFlow"
                    app:layout_constraintStart_toEndOf="@id/accentCashFlow" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCashFlow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hairline"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@id/accentCashFlow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/cashFlowChart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:contentDescription="@string/dashboard_cashflow_chart_desc"
                        android:padding="14dp" />

                </com.google.android.material.card.MaterialCardView>

                <!-- ===== Section 3: Allocation ===== -->
                <View
                    android:id="@+id/accentAllocation"
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_section_accent"
                    app:layout_constraintTop_toBottomOf="@id/cardCashFlow"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvAllocationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/dashboard_allocation_title"
                    android:textAppearance="@style/TextAppearance.Capitall.SectionTitle"
                    app:layout_constraintTop_toTopOf="@id/accentAllocation"
                    app:layout_constraintBottom_toBottomOf="@id/accentAllocation"
                    app:layout_constraintStart_toEndOf="@id/accentAllocation" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAllocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hairline"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@id/accentAllocation"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/donutChart"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:contentDescription="@string/dashboard_allocation_chart_desc" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewLegend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ===== Section 4: Insights, ומתחתיו טבלת העסקאות ===== -->
                <!--
                  שני הכרטיסים היו זה לצד זה בחצי רוחב, אבל טבלת עסקאות עם ארבע עמודות
                  לא נכנסת ל-~180dp. שניהם ברוחב מלא, זה מתחת לזה.
                -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardInsights"
                    style="@style/Widget.Capitall.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    app:layout_constraintTop_toBottomOf="@id/cardAllocation"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_insights_title"
                            android:textColor="@color/accent_blue"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewInsights"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTransactions"
                    style="@style/Widget.Capitall.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toBottomOf="@id/cardInsights"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <!-- כותרת הכרטיס + קיצור לטבלה המלאה -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dashboard_transactions_title"
                                android:textColor="@color/accent_blue"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTransactionsViewAll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="4dp"
                                android:text="@string/dashboard_transactions_view_all"
                                android:textColor="@color/accent_blue"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!--
                          שורת העמודות. הסדר הלוגי הוא תאריך ← קטגוריה ← תיאור ← סכום,
                          והמסגרת מהפכת אותו בעברית — כך התאריך יוצא בימין והסכום בשמאל,
                          בדיוק כמו בדף חשבון בנקאי ישראלי.
                        -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="42dp"
                                android:text="@string/screener_col_date"
                                android:textAppearance="@style/TextAppearance.Capitall.MetricLabel"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minWidth="64dp"
                                android:text="@string/add_transaction_category_label"
                                android:textAppearance="@style/TextAppearance.Capitall.MetricLabel"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="@string/screener_col_merchant"
                                android:textAppearance="@style/TextAppearance.Capitall.MetricLabel"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:gravity="end"
                                android:text="@string/screener_col_amount"
                                android:textAppearance="@style/TextAppearance.Capitall.MetricLabel"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="@color/hairline" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewTransactions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

            <!--
              כפתור ההוספה מעוגן לפינה השמאלית-תחתונה ונשאר במקומו בזמן גלילה.
              "left" ולא "start" בכוונה: המיקום זהה בעברית ובאנגלית ולא מתהפך עם כיוון השפה.
            -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddAsset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:layout_margin="20dp"
                android:contentDescription="@string/dashboard_add_asset_desc"
                android:src="@drawable/ic_add"
                app:backgroundTint="@color/accent_blue"
                app:borderWidth="0dp"
                app:tint="#FFFFFF"
                tools:ignore="RtlHardcoded" />

        </FrameLayout>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
