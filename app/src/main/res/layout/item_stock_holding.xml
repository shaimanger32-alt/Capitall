<?xml version="1.0" encoding="utf-8"?>
<!-- שורת אחזקה: מונוגרמת סימול + שם, שווי שוק ובאדג' רווח/הפסד, ושורת נתונים תחתונה -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_sm"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/elevation_flat"
    app:strokeColor="@color/hairline"
    app:strokeWidth="@dimen/hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- מונוגרמה: ראשי הסימול בעיגול-מרובע כחול-רך (זהות ויזואלית לכל מניה) -->
            <TextView
                android:id="@+id/tvTicker"
                android:layout_width="@dimen/icon_container"
                android:layout_height="@dimen/icon_container"
                android:background="@drawable/bg_category_icon"
                android:backgroundTint="@color/accent_soft_bg"
                android:gravity="center"
                android:maxLength="4"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSymbol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMarketValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGainLoss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_pill_soft"
                    android:textAppearance="@style/TextAppearance.Capitall.Badge" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="@dimen/space_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/portfolio_delete_confirm"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                app:tint="@color/on_surface_muted" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@color/hairline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAvgCost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCurrentPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_muted"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
