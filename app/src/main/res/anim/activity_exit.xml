<?xml version="1.0" encoding="utf-8"?>
<!-- יציאת המסך שמתחת: נסיגה עדינה לעומק -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_quad">
    <alpha android:fromAlpha="1" android:toAlpha="0.7" android:duration="220" />
    <scale android:fromXScale="1" android:toXScale="0.97"
        android:fromYScale="1" android:toYScale="0.97"
        android:pivotX="50%p" android:pivotY="50%p" android:duration="220" />
</set>
